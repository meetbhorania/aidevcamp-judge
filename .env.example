# Copy to .env and fill in. Never commit the real .env.

# Gemini API key from Google AI Studio (free tier is fine)
GOOGLE_API_KEY=
# Use the Gemini API, not Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Model used by the agents
JUDGE_MODEL=gemini-2.5-flash

# GitHub personal access token (fine-grained, public repo read-only is enough)
GITHUB_TOKEN=

# Event window, local time in Europe/London
EVENT_DATE=2026-10-31
EVENT_START=09:00
SUBMISSION_DEADLINE=16:00
